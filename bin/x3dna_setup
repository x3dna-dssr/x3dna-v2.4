#!/usr/bin/env ruby

### Set up X3DNA running environment
###     3DNA v2.4, maintained at https://github.com/x3dna-dssr/x3dna-v2.4
###     Questions & feedback: https://github.com/x3dna-dssr/x3dna-v2.4/discussions

$VERBOSE = true
homedir = File.expand_path("../..", __FILE__)

shell = File.basename(ENV["SHELL"] || ENV["XTERM_SHELL"] || "not-set")
shell = "sh" if shell == "not-set" && ENV["MSYSTEM"]  # MINGW32

msg_env = "set up the X3DNA environment variable"
msg_path = "add $X3DNA/bin to your command search path"

case shell
when "bash", "sh", "zsh"
    rcfile = if shell == "bash"
        "~/.bashrc"
    elsif shell == "sh"
        "~/.profile"
    else  # zsh
        "~/.zshrc"
    end
    envar = "export X3DNA='#{homedir}'"
    pathvar = "export PATH='#{homedir}/bin':$PATH"
when "tcsh", "csh"
    rcfile = "~/.cshrc"
    envar = "setenv X3DNA '#{homedir}'"
    pathvar = "setenv PATH '#{homedir}/bin':$PATH"
else
    if shell == "not-set"
        puts "The SHELL environment variable is not detected -- MinGW/MSYS?"
    else
        puts "Unknown shell #{shell}"
    end
    puts <<~TXT

        You need to set up 3DNA manually:
            o #{msg_env}
                 #{homedir}
            o #{msg_path}
                 #{homedir}/bin

        Overall, getting 3DNA up and running should be straightforward. If you
        encounter any issues, please post them at GitHub Discussions:
        https://github.com/x3dna-dssr/x3dna-v2.4/discussions
    TXT
    exit
end

sline = "+" * 72
puts <<~TXT
    #{sline}
    To install 3DNA from GitHub, do as follows:
      (1) clone or download the repository:
              git clone https://github.com/x3dna-dssr/x3dna-v2.4.git
      (2) compile the C executables:
              cd x3dna-v2.4/src
              make
      (3) set up your environment:
              cd ../bin
              ./x3dna_setup

              To run 3DNA, you need to do two things:
                  o #{msg_env}
                  o #{msg_path}

              For your '#{shell}' shell, add the following to #{rcfile}:
              --------------------------------------------------------------
                  #{envar}
                  #{pathvar}
              --------------------------------------------------------------
              Then run: source #{rcfile}

      (4) to verify your installation, run:
              find_pair -h
              (you should see the command-line help message)

    Questions or issues? Visit GitHub Discussions:
    https://github.com/x3dna-dssr/x3dna-v2.4/discussions
    #{sline}
TXT
